</parameternamelist>
<parameterdescription>
<para>Payload size in bytes (&gt; 0). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>crc</parametername>
</parameternamelist>
<parameterdescription>
<para>Integrity tag storage. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>shadow</parametername>
</parameternamelist>
<parameterdescription>
<para>Redundant shadow buffer of <computeroutput>len</computeroutput> bytes, or NULL if disabled. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>0 on success, -EINVAL on bad arguments. </para>
</simplesect>
</para>
