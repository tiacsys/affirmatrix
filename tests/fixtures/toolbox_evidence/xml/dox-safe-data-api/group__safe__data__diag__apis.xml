      <memberdef kind="function" id="group__safe__data__diag__apis_1gaf59812adbd045cc7780afb28bb754bf5" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int safe_data_fault_handler_register</definition>
        <argsstring>(safe_data_fault_cb_t cb)</argsstring>
        <name>safe_data_fault_handler_register</name>
        <param>
          <type><ref refid="group__safe__data__diag__apis_1ga2d0829e314a14bb1bf85d61129cc2c85" kindref="member">safe_data_fault_cb_t</ref></type>
          <declname>cb</declname>
        </param>
        <satisfies>
          <requirement refid="requirement_SD-REQ-013"></requirement>
        </satisfies>
        <briefdescription>
<para>Register the fault handler callback. </para>
        </briefdescription>
        <detaileddescription>
<para>When registered, the callback receives ALL integrity events (recoveries, timeouts, overwritten-corrupt, clamped returns), independent of the configured CONFIG_SAFE_DATA_FAULT_* reaction - which still governs the control-flow response to an unrecoverable fault (return vs panic).</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>cb</parametername>
</parameternamelist>
<parameterdescription>
<para>Handler, or NULL to unregister. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>0 on success, -EALREADY if a (different) handler is registered. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
