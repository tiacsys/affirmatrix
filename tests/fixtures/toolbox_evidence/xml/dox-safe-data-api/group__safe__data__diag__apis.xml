    <sectiondef kind="typedef">
      <memberdef kind="typedef" id="group__safe__data__diag__apis_1ga2d0829e314a14bb1bf85d61129cc2c85" prot="public" static="no">
        <type>void(*</type>
        <definition>typedef void(* safe_data_fault_cb_t) (const struct safe_data_fault_info *info)</definition>
        <argsstring>)(const struct safe_data_fault_info *info)</argsstring>
        <name>safe_data_fault_cb_t</name>
        <briefdescription>
<para>Fault/diagnostic event callback. </para>
        </briefdescription>
        <detaileddescription>
<para>May be invoked while the affected container&apos;s lock is held: the handler must not block and must not access any safe container (AoU: record the event, set a flag/semaphore for a monitor thread, or drive the safe state).</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>info</parametername>
</parameternamelist>
<parameterdescription>
<para>Event descriptor (kind, affected payload, size). Only valid for the duration of the call; copy what you need. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="include/safe_data/safe_data.h" line="149" column="9" bodyfile="include/safe_data/safe_data.h" bodystart="149" bodyend="-1"/>
      </memberdef>
    </sectiondef>
