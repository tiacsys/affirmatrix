</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>_pvar</parametername>
</parameternamelist>
<parameterdescription>
<para>Name of the typed payload-pointer variable scoped to the block.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
