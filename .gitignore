# Byte-compiled / cache
__pycache__/
*.py[cod]

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/

# Test / lint caches
.pytest_cache/
.ruff_cache/
.coverage

# Doc build output (python -m doc builds into build/)
doc/**/_build/

# The affirmation store lineage (ADR-0009): case/ is a worktree of the
# orphan case branch, never content of this branch.
/case/

# Pages generated at build time from the tests and the test run
doc/*/_generated/
